!
! ============================================================================
! MLAG Configuration
! ============================================================================
!
{% if mlag_domain_id is defined and mlag_domain_id %}
{% set mlag_config = netbox_config_context.mlag | default({}) %}
{% set peer_link_vlan = mlag_config.peer_link_vlan | default(4094) %}
{% set reload_delay_mlag = mlag_config.reload_delay_mlag | default(300) %}
{% set reload_delay_non_mlag = mlag_config.reload_delay_non_mlag | default(330) %}
!
vlan {{ peer_link_vlan }}
   name MLAG-PEER-LINK
   trunk group MLAG
!
interface Port-Channel1000
   description MLAG Peer Link
   switchport mode trunk
   switchport trunk group MLAG
!
interface Vlan{{ peer_link_vlan }}
   description MLAG Peer Link SVI
   no autostate
   ip address 169.254.1.{{ mlag_domain_id }}/30
!
mlag configuration
   domain-id {{ fabric_name | default('dc1-fabric') }}-{{ mlag_domain_id }}
   local-interface Vlan{{ peer_link_vlan }}
   peer-link Port-Channel1000
{% if mlag_peer is defined and mlag_peer %}
   peer-address 169.254.1.{{ (mlag_domain_id | int % 2) + 1 }}
{% endif %}
   reload-delay mlag {{ reload_delay_mlag }}
   reload-delay non-mlag {{ reload_delay_non_mlag }}
!
{% endif %}

