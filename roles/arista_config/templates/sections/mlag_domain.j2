! # START mlag_domain.j2
vlan {{ mlag_domain.peerlink_vlan | default(4094) }}
   name MLAG_PEER
   trunk group MLAG
!
no spanning-tree vlan-id {{ mlag_domain.peerlink_vlan | default(4094) }}
!
interface Port-Channel{{ mlag_domain.peerlink_channel | default(2000) }}
   description {{ mlag_domain.description | default('MLAG PeerLink') }}
   switchport
   switchport mode trunk
   switchport trunk group MLAG
   no shutdown
!
{% for interface in mlag_domain.interfaces | default([]) %}
{% set eos_name = 'Ethernet' ~ interface[3:] if interface.lower().startswith('eth') and not interface.lower().startswith('ethernet') else interface %}
interface {{ eos_name }}
   description {{ mlag_domain.description | default('MLAG PeerLink') }}
   channel-group {{ mlag_domain.peerlink_channel | default(2000) }} mode active
   no shutdown
!
{% endfor %}
!
interface Vlan{{ mlag_domain.peerlink_vlan | default(4094) }}
   description {{ mlag_domain.description | default('MLAG PeerLink') }}
   no autostate
{% if (mlag_index | int) == 0 %}
   ip address {{ mlag_domain.peerlink_network | default('169.254.1.0/31') | ansible.utils.ipaddr('net') | ansible.utils.ipaddr(0) }}
{% else %}
   ip address {{ mlag_domain.peerlink_network | default('169.254.1.0/31') | ansible.utils.ipaddr('net') | ansible.utils.ipaddr(1) }}
{% endif %}
   mtu {{ fabric_defaults.underlay_mtu | default(9214) }}
!
mlag configuration
   domain-id {{ mlag_name | default('MLAG-DOMAIN') }}
   local-interface Vlan{{ mlag_domain.peerlink_vlan | default(4094) }}
   reload-delay mlag 30
   reload-delay non-mlag 30
{% if (mlag_index | int) == 0 %}
   peer-address {{ mlag_domain.peerlink_network | default('169.254.1.0/31') | ansible.utils.ipaddr('net') | ansible.utils.ipaddr(1) | ansible.utils.ipaddr('address') }}
{% else %}
   peer-address {{ mlag_domain.peerlink_network | default('169.254.1.0/31') | ansible.utils.ipaddr('net') | ansible.utils.ipaddr(0) | ansible.utils.ipaddr('address') }}
{% endif %}
   peer-link Port-Channel{{ mlag_domain.peerlink_channel | default(2000) }}
!
! # END mlag_domain.j2

