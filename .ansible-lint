---
# =============================================================================
# Ansible Lint Configuration
# =============================================================================

# Exclude paths from linting
exclude_paths:
  - .git/
  - .github/
  - output/
  - clab/
  - venv/
  - .venv/
  # Exclude NAPALM playbook as it requires optional collection not installed
  - playbooks/push_configs_napalm.yml

# Skip specific rules
skip_list:
  # Skip FQCN for builtin modules (allow 'debug' instead of 'ansible.builtin.debug')
  - fqcn[action-core]
  # Skip experimental rules
  - experimental
  # Skip meta requirements (no meta/main.yml needed for simple roles)
  - meta-no-info
  # Skip galaxy metadata
  - galaxy[no-changelog]
  # Skip handler naming (not using handlers heavily)
  - no-handler
  # Skip role name validation
  - role-name[path]
  # Skip variable naming prefix rule (templates use these vars directly)
  - var-naming[no-role-prefix]
  # Skip run_once warnings (acceptable in our linear strategy context)
  - run-once[task]

# Warn but don't fail on these
warn_list:
  # Command modules should use warn parameter
  - command-instead-of-module
  # No changed when (for commands that don't change state)
  - no-changed-when
  # Risky file permissions
  - risky-file-permissions
  # YAML line length (we use 200 in yamllint)
  - yaml[line-length]

# Offline mode - don't try to fetch galaxy roles
offline: true

# Use default rules
use_default_rules: true

# Parseable output format for CI
parseable: true

# Show progress
quiet: false

# Loop variable prefix
loop_var_prefix: ''

# Variables naming pattern
var_naming_pattern: "^[a-z_][a-z0-9_]*$"
