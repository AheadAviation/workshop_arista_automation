# =============================================================================
# ContainerLab Topology - Generated from NetBox
# =============================================================================
# This topology file is generated by Ansible from NetBox inventory.
# Do not edit manually - changes will be overwritten.
# =============================================================================

name: {{ clab_topology_name }}

mgmt:
  network: {{ clab_topology_name }}_mgmt
  ipv4-subnet: {{ clab_mgmt_subnet }}

topology:
  kinds:
    ceos:
      image: {{ ceos_image }}

  nodes:
{% for device in lab_devices %}
{% set mgmt_ip = device_mgmt_ips[device] | default('') %}
    {{ device }}:
      kind: ceos
      startup-config: ../output/configs/{{ device }}.cfg
{% if mgmt_ip %}
      mgmt-ipv4: {{ mgmt_ip }}
{% endif %}

{% endfor %}

  links:
    # Spine to Leaf connections
    # spine-01 connections
    - endpoints: ["spine-01:eth1", "leaf-01:eth1"]
    - endpoints: ["spine-01:eth2", "leaf-02:eth1"]
    - endpoints: ["spine-01:eth3", "leaf-03:eth1"]
    - endpoints: ["spine-01:eth4", "leaf-04:eth1"]
    
    # spine-02 connections
    - endpoints: ["spine-02:eth1", "leaf-01:eth2"]
    - endpoints: ["spine-02:eth2", "leaf-02:eth2"]
    - endpoints: ["spine-02:eth3", "leaf-03:eth2"]
    - endpoints: ["spine-02:eth4", "leaf-04:eth2"]
    
    # MLAG Peer Links
    # Pair 1: leaf-01 <-> leaf-02
    - endpoints: ["leaf-01:eth3", "leaf-02:eth3"]
    - endpoints: ["leaf-01:eth4", "leaf-02:eth4"]
    
    # Pair 2: leaf-03 <-> leaf-04
    - endpoints: ["leaf-03:eth3", "leaf-04:eth3"]
    - endpoints: ["leaf-03:eth4", "leaf-04:eth4"]

